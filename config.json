{
  "run_mode": "single",
  "algorithm": "gpomdp",
  "device": "auto",

  "env_id": "CartPole-v1",
  "seed": 23,
  "seeds": [23, 24, 25, 26, 27],
  "seed_workers": 1,

  "n_iterations": 200,
  "n_envs": 16,
  "n_trajectories": 1,
  "horizon": 200,

  "gamma": 0.99,
  "returns_implementation": "recursive",
  "lr": 1e-3,
  "lr_npg": 0.01,
  "npg_damping": 0.01,
  "entropy_coeff": 0.01,

  "center_returns": true,
  "normalize_returns": true,
  "clip_actions": true,

  "hidden_sizes": [32, 32],
  "policy": "mlp",

  "init_log_std": -0.5,
  "learn_std": true,

  "save_plots": true,
  "save_checkpoints": true,
  "checkpoint_interval": 500,
  "log_metrics": true,
  "record_video": false
}
